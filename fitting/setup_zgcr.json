{
    "root_filename": "fitting_{year}_control-zgamma.root",
    "qcd_proc": "GJets",
    "pt_min_scale": 200.0,
    "regions_to_fit": ["bb"],
    "do_systematics": true,
    "active_systematics": ["pileup", "JES", "JER"],
    "rho_scaling_max": -1.0,

    "observable": { "name": "msd", "min": 20, "max": 201, "nbins": 23 },

    "categories": {
        "zgcr": { "bins": [250, 1200] }
    },

    "process_groups": {
        "zgammabb": { "components": [["Zgamma", "bb"], ["Zjets", "bb"]], "is_signal": true },
        "wgammacs": { "components": [["Wgamma", "bb"], ["Wjets", "bb"]], "is_signal": false },
        "other": { "components": [["Zgamma", ""], ["ttbar", ""]], "is_signal": false }
    },
    "physics_model": {
        "model": "HiggsAnalysis.CombinedLimit.PhysicsModel:multiSignalModel",
        "maps": [
            "map=.*/zgammabb:r[1,-100,100]"
        ]
    }
}

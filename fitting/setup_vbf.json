{
    "root_filename": "signalregion.root",
    "qcd_proc": "QCD",
    "pt_min_scale": 450.0,
    "regions_to_fit": ["bb", "cc"],
    "do_systematics": true,
    "active_systematics": ["pileup", "JES", "JER", "UES", "btagSFb", "btagSFc", "btagSFlight"],

    "observable": { "name": "msd", "min": 40, "max": 201, "nbins": 23 },

    "categories": {
        "ggf": { "bins": [450, 1200] },
        "vbf": { "bins_pt": [450, 1200] },
        "vh":  { "bins": [450, 1200] }
    },

    "process_groups": {
        "ggF": { "components": [["ggF", ""]], "is_signal": true },
        "VBF": { "components": [["VBF", ""]], "is_signal": true },
        "WH":  { "components": [["WH", ""]], "is_signal": true },
        "ZH":  { "components": [["ZH", ""]], "is_signal": true },
        "ttbar": { "components": [["ttbar", ""]], "is_signal": false },
        "Wjets": { "components": [["Wjets", ""]], "is_signal": false }
    },
    "physics_model": {
        "model": "HiggsAnalysis.CombinedLimit.PhysicsModel:multiSignalModel",
        "maps": [
            "map=.*/ggF:rggF[1,-20,20]",
            "map=.*/VBF:rVBF[1,-20,20]"
        ]
    }
}

{
    "root_filename": "fitting_{year}_msd.root",
    "data_obs_name": "Jetdata",
    "qcd_proc": "QCD",
    "pt_min_scale": 450.0,
    "regions_to_fit": ["bb", "cc"],
    "do_BDT_regions": false,
    "rho_scaling_max": -2.1,
    "do_systematics": true,
    "do_muon_CR": true,
    "active_systematics": [
        "pileup", "JES", "JER", "UES",
        "ISRPartonShower", "FSRPartonShower",
        "btagSFb", "btagSFc", "btagSFlight",
        "btagSFb_correlated", "btagSFc_correlated", "btagSFlight_correlated",
        "pdf_Higgs", "QCDScale","VJets"
    ],

    "samples_qq": ["Wjets", "Zjets", "EWKW", "EWKZ", "EWKV"],

    "observable": {
        "name": "msd",
        "branch_name": "FatJet0_msdmatched",
        "min": 40,
        "max": 201,
        "nbins": 23
    },

"categories": {
        "ggf": { "bins": [450, 1200] },
        "vbf": {
            "bins": [1000, 13000],
            "bins_pt": [450, 1200],
            "bin_branch": "VBFPair_mjj",
            "bin_prefix": "mjj"
        },
        "vh":  { "bins": [450, 1200] },
        "mucr":  { "bins": [450, 1200] }
    },

    "process_groups": {
        "ggFbb": { "components": [["ggFbb", ""]], "is_signal": true },
        "VBFbb": { "components": [["VBFbb", ""]], "is_signal": true },
        "WHbb":  { "components": [["WHbb", ""]], "is_signal": true },
        "ZHbb":  { "components": [["ZHbb", ""]], "is_signal": true },
        "ggFcc": { "components": [["ggFcc", ""]], "is_signal": true },
        "VBFcc": { "components": [["VBFcc", ""]], "is_signal": true },
        "WHcc":  { "components": [["WHcc", ""]], "is_signal": true },
        "ZHcc":  { "components": [["ZHcc", ""]], "is_signal": true },
        "ttH": { "components": [["ttH", ""]], "is_signal": false },
        "ttbar": { "components": [["ttbar", ""]], "is_signal": false },
        "singlet": { "components": [["singlet", ""]], "is_signal": false },
        "VV":    { "components": [["VV", ""]], "is_signal": false },

        "Wjets": { "components": [["Wjets", "c"], ["Wjets", "light"]], "is_signal": false },
        "EWKW":  { "components": [["EWKW", "c"], ["EWKW", "light"]], "is_signal": false },

        "Zjetsbb": { "components": [["Zjets", "bb"]], "is_signal": false },
        "Zjetsc":  { "components": [["Zjets", "c"]], "is_signal": false },
        "Zjetslight": { "components": [["Zjets", "light"]], "is_signal": false },
        "EWKZbb": { "components": [["EWKZ", "bb"]], "is_signal": false },
        "EWKZc":  { "components": [["EWKZ", "c"]], "is_signal": false },
        "EWKZlight": { "components": [["EWKZ", "light"]], "is_signal": false }
    },

    "physics_model": {
        "model": "HiggsAnalysis.CombinedLimit.PhysicsModel:multiSignalModel",
        "maps": [
            "map=.*/ggFbb:rggF_bb[1,-20,20]",
            "map=.*/VBFbb:rVBF_bb[1,-20,20]",
            "map=.*/WHbb:rVH_bb[1,-20,20]",
            "map=.*/ZHbb:rVH_bb[1,-20,20]",
            "map=.*/ggFcc:rggF_cc[1,-20,20]",
            "map=.*/VBFcc:rVBF_cc[1,-20,20]",
            "map=.*/WHcc:rVH_cc[1,-20,20]",
            "map=.*/ZHcc:rVH_cc[1,-20,20]"
        ]
    }
}

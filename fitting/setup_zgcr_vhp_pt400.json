{
    "data_obs_name": "EGammadata",
    "root_filename": "fitting_{year}_zgcr_vhp_pt400.root",
    "qcd_proc": "GJets",
    "pt_min_scale": 400.0,
    "regions_to_fit": ["bb"],
    "use_modified_disc": false,
    "disc_mode": "bbvsqcd",
    "working_point": 0.99,
    "use_regressed_mass": true,
    "do_systematics": false,
    "active_systematics": [],
    "jmsr_scale": 7,
    "jmsr_smear": 0.5,
    "jmsr_processes": ["zgammabb"],
    "rho_scaling_max": -1.0,
    "samples_qq": ["Wjets", "Zjets", "Wgamma", "Zgamma", "TTGamma"],

    "observable": {
        "name": "regmass",
        "branch_name": "FatJet0_ParTmassX2p",
        "min": 60,
        "max": 220,
        "nbins": 20
    },

    "categories": {
        "zgcr": {
            "name": "control-zgamma",
            "bins": [400, 500],
            "bin_branch": "FatJet0_pt",
            "bin_prefix": "pt"
        }
    },

    "process_groups": {
        "zgammabb": { "components": [["Zgamma", "bb"], ["Zjets", "bb"]], "is_signal": true },
        "zgammacc": { "components": [["Zgamma", "c"], ["Zjets", "c"]], "is_signal": false },
        "wgammacs": { "components": [["Wgamma", "c"], ["Wjets", "c"]], "is_signal": false },
        "other": {
            "components": [
                ["Wgamma", "bb"],
                ["Wjets", "bb"],
                ["Zgamma", "light"],
                ["Wgamma", "light"],
                ["Zjets", "light"],
                ["Wjets", "light"],
                ["ttbar", ""]
            ],
            "is_signal": false
        }
    },

    "physics_model": {
        "model": "HiggsAnalysis.CombinedLimit.PhysicsModel:multiSignalModel",
        "maps": [
            "map=.*passbb.*/zgammabb:r_bb[1,-100,100]"
        ]
    }
}
